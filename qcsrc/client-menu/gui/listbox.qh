entity(void) gui_listbox_spawn;
.void(entity, vector, vector, vector, vector) resizeNotify;
.void(entity, float, float) configureListBox;
.void(entity) draw;
.float(entity, float, float, float) keyDown;
.float(entity, vector) mousePress;
.float(entity, vector) mouseDrag;
.float(entity, vector) mouseRelease;
.float(entity, vector) mouseDoubleClick;
.float focusable;
.float selectedItem;
.vector size;
.vector origin;
.float scrollPos; // measured in window heights, fixed when needed
.float previousValue;
.float pressed; // 0 = normal, 1 = scrollbar dragging, 2 = item dragging, 3 = released
.float pressOffset;
.void(entity) updateControlTopBottom;
.float controlTop;
.float controlBottom;
.float controlWidth;
.float dragScrollTimer;
.vector dragScrollPos;
.string src; // scrollbar
.vector color;
.vector color2;
.vector colorC;
.vector colorF;
.vector tolerance; // drag tolerance
.float scrollbarWidth; // pixels
.float nItems;
.float itemHeight;
.void(entity, float, vector, float) drawListBoxItem; // item number, width/height, selected
.void(entity, float, vector, float) clickListBoxItem; // item number, relative clickpos, double click
.void(entity, float) setSelected;
void(entity me, float i) gui_listbox_select;
void(entity me, vector relOrigin, vector relSize, vector absOrigin, vector absSize) gui_listbox_resize;
void(entity me, float i, vector absSize, float selected) gui_listbox_item_draw;
float(entity me, float key, float ascii, float shift) gui_listbox_key_down;
float(entity me, vector pos) gui_listbox_mouse_drag;
