entity spawnNexuizVideoSettingsTab() {
	entity me; me = spawnNexuizTab();
	me.fill = fillNexuizVideoSettingsTab;
	me.title = _("Video");
	me.intendedWidth = 0.9;
	me.rows = 22;
	me.columns = 6.5;
	me.classname = "NexuizVideoSettingsTab";
	return me;
}
entity makeNexuizVideoSettingsTab();
